# FastAPI origin used by the Vite dev/preview proxy. Restart Vite after changes.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local/demo reminder attribution only, until authentication exists.
# Set to the created_by ID printed by python -m app.scripts.seed_demo.
# No default identity: empty disables reminder creation. Restart Vite after changes.
VITE_DEMO_USER_ID=

# Telegram credentials and demo chat ID belong only in the backend/root .env.
# Phone demo: allow the exact temporary tunnel hostname when starting Vite with
# __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS (see README); do not disable host checks.
