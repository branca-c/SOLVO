# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_NAME=SOLVO API
APP_VERSION=0.1.0
APP_SECRET_KEY=replace-with-a-long-random-local-value

# Local URLs and browser access
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (local development defaults only)
POSTGRES_DB=solvo
POSTGRES_USER=solvo
POSTGRES_PASSWORD=solvo-local-only
DATABASE_URL=postgresql+psycopg://solvo:solvo-local-only@localhost:5432/solvo

# Deterministic local providers; cloud/external integrations are deferred.
# mock is local and deterministic; fake remains a compatibility alias.
AI_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock
# Testo dimostrativo: il mock non riconosce il contenuto audio.
TRANSCRIPTION_MOCK_TEXT="Perdita di acqua dal tubo del bagno."
OBJECT_STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=fake
LOCAL_STORAGE_PATH=./storage
TECHNICIAN_LINK_BASE_URL=http://localhost:5173/tecnico

# Upload and action-token safety defaults
MAX_AUDIO_UPLOAD_MB=10
TECHNICIAN_ACTION_TOKEN_TTL_MINUTES=1440

# Frontend Vite proxy configuration is in frontend/.env.example.
# Copy that file to frontend/.env; its default backend is http://127.0.0.1:8000.
