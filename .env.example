# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_NAME=SOLVO API
APP_VERSION=0.1.0
APP_SECRET_KEY=replace-with-a-long-random-local-value

# Local URLs and browser access
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (local development defaults only)
POSTGRES_DB=solvo
POSTGRES_USER=solvo
POSTGRES_PASSWORD=solvo-local-only
DATABASE_URL=postgresql+psycopg://solvo:solvo-local-only@localhost:5432/solvo

# Local providers by default; Telegram Bot API is explicitly opt-in.
# mock is local and deterministic; fake remains a compatibility alias.
AI_PROVIDER=mock
# ollama: real local structured extraction; choose an already-installed model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=30m
# groq: OpenAI-compatible cloud structured extraction. Keep the key server-side.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=60
# mock: deterministic demo; local_whisper: real local speech recognition.
TRANSCRIPTION_PROVIDER=mock
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=it
WHISPER_BEAM_SIZE=5
# Testo dimostrativo: il mock non riconosce il contenuto audio.
TRANSCRIPTION_MOCK_TEXT="Perdita di acqua dal tubo del bagno."
OBJECT_STORAGE_PROVIDER=local
NOTIFICATION_PROVIDER=mock
LOCAL_STORAGE_PATH=./storage
# Required for signed links: generate locally with secrets.token_urlsafe(32).
# Leave empty until configured; link/notification endpoints then fail closed (503).
ASSIGNMENT_ACTION_SECRET=
# Same-PC testing. For phones use the reachable HTTPS Quick Tunnel URL (see README).
TECHNICIAN_ACTION_BASE_URL=http://127.0.0.1:5173
# Used only with NOTIFICATION_PROVIDER=telegram; server-side only, never VITE_ variables.
TELEGRAM_BOT_TOKEN=
# Demo shortcut: all technician notifications go to this numeric chat ID.
TELEGRAM_DEMO_CHAT_ID=

# Upload and action-token safety defaults
MAX_AUDIO_UPLOAD_MB=10
TECHNICIAN_ACTION_TOKEN_TTL_MINUTES=1440

# Frontend Vite proxy configuration is in frontend/.env.example.
# Copy that file to frontend/.env; its default backend is http://127.0.0.1:8000.
